# Curbside. Copy to .env for local development. Never commit .env.

# Agent model: an OpenAI-compatible endpoint that supports the Responses API and images.
OPENAI_API_KEY=
OPENAI_BASE_URL=
CURBSIDE_MODEL=
AGENT_ENGINE=curbside-vision
AGENT_MODEL=curbside-vision
# Optional alternative engine (select it in the chat's model menu).
# GOOGLE_GENERATIVE_AI_API_KEY=
# AGENT_BUILT_IN_ENGINES=ai-sdk:google

# OAuth 2 token (scope write_api) for your account on master.apis.dev.openstreetmap.org.
OSM_SANDBOX_DEMO_TOKEN=

# Local database (PGlite). Deployments use a hosted Postgres URL.
DATABASE_URL=pglite:./data/pglite

# Test-only switches for scripts/e2e-sandbox.mjs. Ignored in production.
# CURBSIDE_ENABLE_FAULTS=1
# CURBSIDE_STALE_UPLOAD_MS=2000

# Production also needs BETTER_AUTH_SECRET (and CRON_SECRET on Vercel).
